# ==============================================================================
# SCRATCH — Environment Configuration Template
# Copy this file to .env and adjust variables for your local development setup.
# In production, ensure all passwords and secret keys are securely generated.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Secret Key (Used for JWT signing - must be at least 32 characters)
# Generate a strong key using: openssl rand -hex 32
SECRET_KEY=change_me_to_a_secure_random_32_character_string_for_local_dev

# CSRF Secret Key for Double-Submit Cookie verification
CSRF_SECRET=change_me_to_another_secure_32_character_string_for_csrf_protection

# Database Roles & Credentials
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scratch

# 1. Admin/Superuser for bootstrap (used in docker init only)
POSTGRES_ADMIN_USER=scratch_admin
POSTGRES_ADMIN_PASSWORD=admin_local_secret_change_me

# 2. Migrator Role (Table Owner, used by Alembic for schema migrations)
MIGRATOR_DB_USER=scratch_migrator
MIGRATOR_DB_PASSWORD=migrator_local_secret_change_me

# 3. Application Runtime Role (Non-superuser, DML only, NOBYPASSRLS)
APP_DB_USER=scratch_app
APP_DB_PASSWORD=app_local_secret_change_me

# Database Connection URLs (Async SQLAlchemy via asyncpg)
DATABASE_URL=postgresql+asyncpg://scratch_app:app_local_secret_change_me@postgres:5432/scratch
MIGRATOR_DATABASE_URL=postgresql+asyncpg://scratch_migrator:migrator_local_secret_change_me@postgres:5432/scratch

# Synchronous URLs for Alembic migrations runner
SYNC_MIGRATOR_DATABASE_URL=postgresql://scratch_migrator:migrator_local_secret_change_me@postgres:5432/scratch

# Redis Configuration (Cache & Celery Broker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Celery Worker Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Security & Cookie Settings
# Set COOKIE_SECURE=true in staging and production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Token Expirations
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
